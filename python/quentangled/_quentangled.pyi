from collections.abc import Sequence
from os import PathLike

class Circuit:
    """Validated quantum circuit built from indexed qubit gates."""

    def __init__(self, num_qubits: int) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    def x(self, target: int) -> None: ...
    def y(self, target: int) -> None: ...
    def z(self, target: int) -> None: ...
    def h(self, target: int) -> None: ...
    def phase(self, target: int, theta: float) -> None: ...
    def cnot(self, control: int, target: int) -> None: ...
    def cz(self, control: int, target: int) -> None: ...
    def swap(self, q1: int, q2: int) -> None: ...
    def unitary(
        self,
        target: int,
        matrix: Sequence[complex],
        error_matrix: Sequence[complex] | None = None,
        duration_ns: float = 0.0,
    ) -> None: ...

class SimulationResult:
    """Final state amplitudes and measurement probabilities."""

    @property
    def num_qubits(self) -> int: ...
    def amplitudes(self) -> list[complex]: ...
    def probabilities(self) -> list[float]: ...
    def probability(self, basis_state: int) -> float | None: ...

class Simulator:
    """Simulator configured for one execution engine and gate settings."""

    def __init__(self, config_path: str | PathLike[str] | None = None) -> None: ...
    def execute(self, circuit: Circuit) -> SimulationResult: ...
    def estimated_duration_ns(self, circuit: Circuit) -> float: ...
